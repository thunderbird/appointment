# Keep the build context clean and reproducible: the image installs deps from
# pnpm-lock.yaml via `pnpm install --frozen-lockfile`, so host-installed node_modules/dist
# must NOT be copied in (they bloat the image, can carry cross-arch native binaries, and can
# desync the frozen lockfile install). See frontend/deploy.dockerfile.
node_modules
dist
.git
*.log
coverage
.env
.env.*
!.env.*.example

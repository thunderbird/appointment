{% extends "includes/base.jinja2" %}
{# Helper vars #}
{% set clock_icon_img = '<div style="display: inline-block; width: 11px; height: 11px; position: relative; top: 2px; background-image: url(data:image/png;base64,); background-size: contain; background-repeat: no-repeat; background-position: center;" role="presentation"></div>' %}
{% set clock_img = '<div style="display: inline-block; width: 15px; height: 15px; position: relative; top: 2px; background-image: url(data:image/png;base64,); background-size: contain; background-repeat: no-repeat; background-position: center;" role="presentation"></div>' %}
{% set calendar_img = '<div style="display: inline-block; width: 14px; height: 14px; position: relative; top: 2px; background-image: url(data:image/png;base64,); background-size: contain; background-repeat: no-repeat; background-position: center;" role="presentation"></div>' %}
{# Code begins! #}
{% block introduction %}
  <div style="color: {{ colour_text_base }}; text-align: center; line-height: 16px;">
    <p style="font-weight: 700; margin: 0;">
      {{ l10n('new-booking-html-heading-name', {'name': name}) }}
    </p>
    <p style="color: {{ colour_text_muted }}; font-size: 9px; line-height: 10px; font-weight: 700; margin: 0;">
      {{ l10n('new-booking-html-heading-email', {'email': email}) }}
    </p>
    <p style="font-weight: 400; margin: 0;">
      {{ l10n('new-booking-html-heading-text', {'schedule_name': schedule_name}, lang=lang) }}
    </p>
  </div>
{% endblock %}
{% block information %}
  <div style="display: flex">
    {# Time details #}
    <div style="width: 100%; font-weight: 700; margin: 24px 12px;">
      <div style="margin-bottom: 6px;">
        {{ clock_img|safe }} {{ time_range }}
        <span style="color: {{ colour_icon_secondary }}; font-size: 9px">{{ timezone }}</span>
      </div>
      <div>
        {{ calendar_img|safe }} {{ day }}
      </div>
    </div>
    {# Chip #}
    <div style="
      min-width: 60px;
      margin-left: auto;
      margin-right: 0;
      text-align: center;
      background-color: {{ colour_tbpro_apmt_secondary }};
      padding: 3px 12px;
      border-radius: 3px;
      font-size: 9px;
      font-weight: 700;
      height: 16px;
      ">
      {{ clock_icon_img|safe }} {{ l10n('new-booking-html-time', {'duration': duration}, lang=lang) }}
    </div>
  </div>
{% endblock %}

{# Helper vars! These are accessible from any template that extends base #}
{% set colour_surface_base = '#FEFFFF' %}
{% set colour_surface_raised = '#FEFFFF' %}
{% set colour_text_base = '#1A202C' %}
{% set colour_text_muted = '#737584' %}
{% set colour_icon_secondary = '#4C4D58' %}
{% set colour_neutral = '#FEFFFF' %}
{% set colour_border = '#E4E4E7' %}
{% set colour_page_background = '#F7F7F7' %}
{% set colour_primary = '#1373D9' %}
{# TODO: remove after redesign: #}
{% set colour_tbpro_apmt_primary = '#008080' %}
{% set colour_tbpro_apmt_primary_hover = '#066769' %}
{% set colour_tbpro_apmt_secondary = '#81D4B5' %}
{% set colour_tbpro_apmt_soft = '#F3F9FC' %}
{% set logo_image = '<img style="width: 190px;" alt="Appointment" src="cid:%(cid)s" />'|format(cid=tbpro_logo_cid) %}

<html lang="{{ l10n('locale', lang=lang if lang else None) }}" style="
  font-size: 13px;
  color: {{ colour_text_base }};
  font-family: 'Inter', sans-serif;
">
<head>
<style>
  .apmt-row { display: flex; }
  @media (max-width: 480px) {
    .apmt-row { flex-direction: column; }
  }
</style>
</head>
<body style="background-color: {{ colour_page_background }}; margin: 0; padding: 24px 12px;">
<div style="margin: 0 auto;">
  <div style="
    box-sizing: border-box;
    background-color: {{ colour_surface_base }};
    border-radius: 24px;
    padding: 32px 16px;
  ">
    <div style="margin-bottom: 24px;">{{ logo_image|safe }}</div>
    {% if self.introduction()|trim %}
    <div style="margin-bottom: 24px;">
      {% block introduction %}{% endblock %}
    </div>
    {% endif %}
    {% if self.information()|trim %}
    <div style="
      box-sizing: border-box;
      margin-left: auto;
      margin-right: auto;
      margin-bottom: 24px;
      max-width: max-content;
      border: 1px solid {{ colour_border }};
      border-radius: 24px;
      padding: 32px 24px;
    ">
      {% block information %}{% endblock %}
    </div>
    {% endif %}
    {% if self.call_to_action()|trim %}
    <div style="text-align: center; max-width: max-content; margin: 0 auto 24px auto;">
      {% block call_to_action %}{% endblock %}
    </div>
    {% endif %}
    {% if not hide_contact_form_url_hint %}
    <div style="text-align: center; color: {{ colour_icon_secondary }};">
      {% set link = '<a href="%(url)s" style="color:%(colour)s;">%(label)s</a>'|format(url=homepage_url + '/contact', colour=colour_icon_secondary, label=l10n('mail-brand-contact-form', lang=lang if lang else None)) %}
      {{ l10n('mail-brand-reply-hint', {'contact_form_link': link}, lang if lang else None)|safe }}
    </div>
    {% endif %}
  </div>
  <div style="margin-top: 24px;">
    {% include './includes/footer.jinja2' %}
  </div>
</div>
</body>
</html>

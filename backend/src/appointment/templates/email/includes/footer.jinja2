{% set colour_text_secondary = '#4C4D58' %}
{% set colour_primary = '#1373D9' %}
{% set copy_list = l10n('mail-brand-footer', lang=lang if lang else None).split("\n") %}
<div style="color: {{ colour_text_secondary }}; font-size: 11px; font-weight: 400; text-align: center;">
  <div class="apmt-row" style="margin-bottom: 12px; gap: 32px; justify-content: center;">
    <a
      href="{{ homepage_url }}/privacy"
      style="color:{{ colour_primary }}; white-space: nowrap;"
    >{{ l10n('mail-brand-footer-privacy', lang=lang if lang else None) }}</a>
    <a
      href="{{ homepage_url }}/terms"
      style="color:{{ colour_primary }}; white-space: nowrap;"
    >{{ l10n('mail-brand-footer-legal', lang=lang if lang else None) }}</a>
    <a
      href="https://www.mozilla.org/about/governance/policies/participation/"
      style="color:{{ colour_primary }}; white-space: nowrap;"
    >{{ l10n('mail-brand-footer-participation', lang=lang if lang else None) }}</a>
    <a
      href="https://support.tb.pro/hc/en-us"
      style="color:{{ colour_primary }}; white-space: nowrap;"
    >{{ l10n('mail-brand-footer-support', lang=lang if lang else None) }}</a>
  </div>
  {% for copy in copy_list %}
    <p style="color:{{ colour_text_muted }}; max-width: 328px; font-size: 12px; display: inline-block;">{{ copy }}&nbsp;</p>
  {% endfor %}
</div>
